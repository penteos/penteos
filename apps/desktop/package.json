{
  "name": "@penteos/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Penteos: an open-source, agentic workbench for penetration testing",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/penteos/penteos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penteos/penteos.git",
    "directory": "apps/desktop"
  },
  "bugs": {
    "url": "https://github.com/penteos/penteos/issues"
  },
  "author": {
    "name": "Penteos",
    "email": "penteos@users.noreply.github.com"
  },
  "productName": "Penteos",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/check-i18n.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "dockview-react": "^8.9.0",
    "lucide-react": "^1.70.0",
    "pagedjs": "0.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^44.10.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "vite": "^8.3.7"
  },
  "build": {
    "appId": "dev.penteos.workbench",
    "productName": "Penteos",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/core",
        "to": "core",
        "filter": [
          "core.mjs",
          "mcp.mjs",
          "package.json",
          "THIRD_PARTY_LICENSES.txt",
          "catalog/**/*"
        ]
      },
      {
        "from": "build-resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "category": "Development",
      "synopsis": "Agentic penetration testing workbench",
      "maintainer": "Penteos <penteos@users.noreply.github.com>",
      "executableName": "penteos",
      "icon": "build-resources/icons",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Penteos",
          "GenericName": "Pentest workbench",
          "GenericName[es]": "Entorno de pentest",
          "Comment": "Agentic workbench for penetration testing",
          "Comment[es]": "Entorno de trabajo agéntico para pruebas de penetración",
          "Categories": "Development;Network;Security;",
          "Keywords": "pentest;security;proxy;nmap;vulnerability;",
          "Keywords[es]": "pentest;seguridad;proxy;nmap;vulnerabilidad;",
          "StartupWMClass": "penteos",
          "Terminal": "false"
        }
      }
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build-resources/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "penteos-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSHumanReadableCopyright": "© 2026 Santiago Habib",
        "LSApplicationCategoryType": "public.app-category.developer-tools"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libgbm1",
        "libdrm2",
        "libasound2t64 | libasound2",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libxkbcommon0",
        "libxcomposite1",
        "libxdamage1",
        "libxrandr2",
        "libuuid1",
        "xdg-utils",
        "fonts-dejavu-core | fonts-liberation2 | fonts-liberation | fonts-freefont-ttf"
      ],
      "packageName": "penteos",
      "appArmorProfile": "build-resources/apparmor-profile"
    },
    "artifactName": "penteos-${version}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.cjs",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "rpm": {
      "packageName": "penteos",
      "depends": [
        "libgtk-3.so.0()(64bit)",
        "libnss3.so()(64bit)",
        "libXss.so.1()(64bit)",
        "libXtst.so.6()(64bit)",
        "libgbm.so.1()(64bit)",
        "libdrm.so.2()(64bit)",
        "libasound.so.2()(64bit)",
        "libxkbcommon.so.0()(64bit)"
      ],
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ],
      "appArmorProfile": "build-resources/apparmor-profile"
    },
    "appImage": {
      "artifactName": "penteos-${version}-${arch}.AppImage"
    },
    "afterSign": "scripts/after-sign.cjs"
  },
  "desktopName": "penteos.desktop"
}
