abi <abi/4.0>,
include <tunables/global>

# Ubuntu 24.04+ (and openSUSE) only let programs with a profile use user namespaces, which
# Chromium's sandbox needs. Both the launcher and the real binary it runs (penteos.bin: the app,
# the core and the Maestro's browser) are covered, so the sandbox stays on for normal users.
profile penteos /opt/Penteos/{penteos,penteos.bin} flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/penteos>
}
