# Dependencies and build output
node_modules/
.pnpm-store/
dist/
build/
release/
.vite/
*.tsbuildinfo
coverage/
.smoke/
apps/desktop/electron/vendor/
!scripts/release/

# Compiled output never lives next to the TypeScript sources
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/test/**/*.js
packages/*/test/**/*.js.map
packages/*/test/**/*.d.ts

# Penteos data: projects and client data must never be committed
*.penteos
*.penteos-tools
data/
engagements/

# Secrets and local configuration
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc

# Editors, OS and tooling
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
*.log
.demo-shots/

# generated by scripts/licenses.mjs
THIRD_PARTY_LICENSES.txt
