  "description": "The contract of Penteos plugins: the manifest, its checks, the template language and the API code plugins get",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/penteos/penteos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penteos/penteos.git",
    "directory": "packages/plugin-sdk"
  },
